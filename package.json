    "test:watch": "vitest",
    "e2e": "vite build && node e2e/run.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "matter-js": "^0.20.0",
    "phaser": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/matter-js": "^0.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~6.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
