{
  "name": "splice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SPLICE — a game about inventing game mechanics, then exploiting them.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
